<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Electron's main and renderer processes require V8 JIT under hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Ad-hoc local builds have no Team ID, so their Electron framework cannot be
         mapped under library validation. This exception is scoped to LuckyTag. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
